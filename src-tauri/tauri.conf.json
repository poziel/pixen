{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixen",
  "version": "0.2.0",
  "identifier": "com.poziel.pixen",
  "build": {
    "beforeDevCommand": "bun run dev:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build:frontend",
    "frontendDist": "../dist",
    "additionalWatchFolders": ["../core"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pixen",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 360,
        "decorations": false,
        "backgroundColor": "#181818"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../assets/pixen.ico"
    ]
  }
}
