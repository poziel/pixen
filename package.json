{
  "name": "pixen-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dependencies.ts dev",
    "dev:frontend": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "check": "vue-tsc --noEmit",
    "build": "bun scripts/dependencies.ts build",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "build:debug": "bun scripts/dependencies.ts debug",
    "build:frontend": "bun run check && vite build",
    "build:cli": "cargo build --release --locked --bin pixen-cli",
    "build:mcp": "cargo build --release --locked --bin pixen-mcp",
    "build:tools": "cargo build --release --locked --bin pixen-cli --bin pixen-mcp",
    "test": "bun test tests/frontend",
    "tauri": "tauri",
    "deps:local": "bun scripts/dependencies.ts local",
    "deps:released": "bun scripts/dependencies.ts released",
    "build:released": "bun scripts/dependencies.ts released-build"
  },
  "dependencies": {
    "@frame/core": "npm:@poziel/frame-core@0.1.0-dev.4.1",
    "@frame/tauri": "npm:@poziel/frame-tauri@0.1.0-dev.4.1",
    "@lucide/vue": "^1.61.0",
    "@tauri-apps/api": "^2",
    "monaco-editor": "0.57.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@types/bun": "^1.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  },
  "overrides": {
    "@frame/core": "npm:@poziel/frame-core@0.1.0-dev.4.1"
  }
}
