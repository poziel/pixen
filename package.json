{
  "name": "pixloom-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "check": "vue-tsc --noEmit",
    "build": "tauri build --no-bundle",
    "build:debug": "tauri build --debug --no-bundle",
    "build:frontend": "bun run check && vite build",
    "build:cli": "cargo build --release --locked --bin pixloom-cli",
    "build:mcp": "cargo build --release --locked --bin pixloom-mcp",
    "build:tools": "cargo build --release --locked --bin pixloom-cli --bin pixloom-mcp",
    "test": "bun test tests/frontend",
    "tauri": "tauri"
  },
  "dependencies": {
    "@frame/core": "file:../../1-codes/frame/packages/core",
    "@tauri-apps/api": "^2",
    "vue": "^3.5.13",
    "@frame/tauri": "file:../../1-codes/frame/packages/tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@types/bun": "^1.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  },
  "overrides": {
    "@frame/core": "file:../../1-codes/frame/packages/core"
  }
}
